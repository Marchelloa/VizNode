{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run VizNode CLI",
      "program": "${workspaceFolder}/src/app.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
